From 9b5fb59bf55b0003a878e900eca42886a0d46785 Mon Sep 17 00:00:00 2001
From: Kitae Noh <5194831+nworkers@users.noreply.github.com>
Date: Mon, 16 Nov 2026 02:11:33 +0900
Subject: [PATCH] emit: a `j` to an address the body owns is a goto, even at a
 function entry

A `j` whose target this body owns was lifted as a goto only when the target
was not a function entry. A loop whose back edge jumps to its own function's
entry therefore became `psp_func_X(); return;` inside psp_body_X: a tail call
that stays flat only if the compiler turns it into a jump, which MSVC does not
guarantee through the psp_func_ -> psp_body_ wrapper. Every iteration then
grows the host stack.

Conditional and likely branches to an owned address already emit a goto; the
`j` path and the label marking now do the same, with PSP_LOOP on backward
targets as the branch paths have.

Measured on DJMAX Portable (ULKS46050): 472 such back edges in 461 functions.
One loop next to the score playback thread runs for a whole song; with a
1 MiB thread stack it overflowed about 90 seconds in. After the change none
remain, function discovery is unchanged, and the host stack of that thread no
longer grows with the length of the song.

The new test hand-assembles a loop with a backward `j` to its own entry; it
fails on the previous emitter (a self call, no loop marker) and passes now.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/allegrexrecomp/emit.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/tools/allegrexrecomp/emit.c b/tools/allegrexrecomp/emit.c
index 9aa568b..02cca5a 100644
--- a/tools/allegrexrecomp/emit.c
+++ b/tools/allegrexrecomp/emit.c
@@ -644,7 +644,7 @@ static void mark_labels(ectx *c, const a_func *fn) {
         if (in.has_target && in.is_branch && owned_by(an, in.target, owner))
             c->is_label[widx(an, in.target)] = 1;
         if (in.is_jump && !in.is_indirect && in.has_target &&
-            owned_by(an, in.target, owner) && !is_function(an, in.target))
+            owned_by(an, in.target, owner))
             c->is_label[widx(an, in.target)] = 1;
         if (in.has_delay_slot && owned_by(an, a + 4, owner))
             c->is_slot[widx(an, a + 4)] = 1;
@@ -1045,7 +1045,8 @@ static void emit_function(ectx *c, const a_func *fn) {
 
         if (in.is_jump) {                        /* j */
             if (have_slot || taken_slot) { comment(c, &slot); emit_simple(c, &slot, "    "); }
-            if (owned_by(an, in.target, owner) && !is_function(an, in.target)) {
+            if (owned_by(an, in.target, owner)) {
+                if (in.target <= a) fprintf(f, "    PSP_LOOP(0x%08Xu);\n", in.target);
                 fprintf(f, "    goto L_%08X;\n", in.target);
             } else {
                 emit_static_call_tail(c, in.target);  /* tail call, and it must stay one */
