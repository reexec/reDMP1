     /* Size the buffer from an actual count rather than a guessed maximum. */
-    int nptr_avail = psp_collect_pointer_seeds(b->data, b->size, e, bias, NULL, 0);
+    int nptr_avail = psp_collect_pointer_seeds_at(b->data, b->size,
