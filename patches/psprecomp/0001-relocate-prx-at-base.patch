-    /* The whole loaded segment, so jump tables in .rodata/.data can be read. */
-    if (e->nsegments) {
-        an->image      = b->data + e->seg[0].offset;
-        an->image_base = e->seg[0].addr;
-        an->image_size = e->seg[0].filesz;
+
+    if (reloc_buf) {
+        int cap = 1 + 512 + 16384;
+        uint32_t *seeds = (uint32_t *)malloc((size_t)cap * sizeof *seeds);
+        if (!seeds) {
+            if (reloc_buf) free(reloc_buf);
+            psp_blob_free(b);
+            return -1;
+        }
+
+        int nseeds = 0;
+        seeds[nseeds++] = e->entry;
+        int nexports = 0;
+
+        if (e->modinfo_size && (e->modinfo_addr - base) + 0x34 <= reloc_sz) {
+            uint32_t ent_top = rd32(reloc_buf + (e->modinfo_addr - base) + 0x24);
+            uint32_t ent_end = rd32(reloc_buf + (e->modinfo_addr - base) + 0x28);
+            if (ent_top >= base && ent_end >= ent_top && (ent_end - base) <= reloc_sz) {
+                uint32_t cur = ent_top - base;
+                while (cur + 16 <= ent_end - base && nexports < 512) {
+                    uint8_t ent_len = reloc_buf[cur + 8];
+                    uint8_t var_cnt = reloc_buf[cur + 9];
+                    uint16_t func_cnt = rd16(reloc_buf + cur + 10);
+                    uint32_t tbl = rd32(reloc_buf + cur + 12);
+                    uint32_t stride = ent_len ? (uint32_t)ent_len * 4 : 16;
+                    if (tbl >= base && (tbl - base) < reloc_sz) {
+                        uint32_t tbl_off = tbl - base;
+                        uint32_t total = (uint32_t)func_cnt + var_cnt;
+                        if (tbl_off + (total + func_cnt) * 4 <= reloc_sz) {
+                            for (uint16_t f = 0; f < func_cnt && nexports < 512; f++) {
+                                uint32_t fn = rd32(reloc_buf + tbl_off + (total + f) * 4);
+                                seeds[nseeds++] = fn;
+                                nexports++;
+                            }
+                        }
+                    }
+                    if (stride < 16) break;
+                    cur += stride;
+                }
+            }
+        }
+
+        int nptr = 0;
+        for (uint32_t s = 0; s < e->shnum; s++) {
+            size_t sh = (size_t)e->shoff + (size_t)s * e->shentsize;
+            if (sh + 40 > b->size) break;
+            uint32_t type = rd32(b->data + sh + 4);
+            if (type != 0x700000A0u) continue;
+            uint32_t off = rd32(b->data + sh + 16);
+            uint32_t sz = rd32(b->data + sh + 20);
+            if ((size_t)off + sz > b->size || (sz % 8) != 0) continue;
+            for (uint32_t r = 0; r + 8 <= sz; r += 8) {
+                uint32_t r_offset = rd32(b->data + off + r);
