+                uint8_t ofsbase = (uint8_t)((r_info >> 8) & 0xFF);
+                if (ofsbase >= e->nsegments) continue;
+                uint32_t patch_off = (e->seg[ofsbase].addr - base) + r_offset;
+                if (patch_off + 4 > reloc_sz) continue;
+
+                if (rtype == R_MIPS_32) {
+                    uint32_t target = rd32(reloc_buf + patch_off);
+                    if ((target & 3) == 0 && target >= e->text_addr && target < e->text_addr + e->text_size) {
+                        if (nseeds + 1 >= cap) {
+                            cap *= 2;
+                            seeds = (uint32_t *)realloc(seeds, (size_t)cap * sizeof *seeds);
+                        }
+                        seeds[nseeds++] = target;
+                        nptr++;
+                    }
+                } else if (rtype == R_MIPS_HI16) {
+                    for (uint32_t k = r + 8; k < sz; k += 8) {
+                        uint32_t next_info = rd32(b->data + off + k + 4);
+                        if ((next_info & 0xFF) == R_MIPS_LO16) {
+                            uint32_t lo_off = rd32(b->data + off + k);
+                            uint8_t lo_ofs = (uint8_t)((next_info >> 8) & 0xFF);
+                            if (lo_ofs < e->nsegments) {
+                                uint32_t lo_patch = (e->seg[lo_ofs].addr - base) + lo_off;
+                                if (lo_patch + 4 <= reloc_sz) {
+                                    uint32_t hi_imm = rd32(reloc_buf + patch_off) & 0xFFFF;
+                                    int32_t lo_imm = (int16_t)(rd32(reloc_buf + lo_patch) & 0xFFFF);
+                                    uint32_t target = (hi_imm << 16) + (uint32_t)lo_imm;
+                                    if ((target & 3) == 0 && target >= e->text_addr && target < e->text_addr + e->text_size) {
+                                        if (nseeds + 1 >= cap) {
+                                            cap *= 2;
+                                            seeds = (uint32_t *)realloc(seeds, (size_t)cap * sizeof *seeds);
+                                        }
+                                        seeds[nseeds++] = target;
+                                        nptr++;
+                                    }
+                                }
+                            }
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+
+        int rc = a_discover(an, seeds, nseeds);
+        free(seeds);
+        if (rc != 0) {
+            fprintf(stderr, "discovery failed (out of memory)\n");
+            if (reloc_buf) free(reloc_buf);
+            psp_blob_free(b);
+            return -1;
+        }
+
+        if (out_nseeds)   *out_nseeds = nseeds;
+        if (out_nexports) *out_nexports = nexports;
+        if (out_nptr)     *out_nptr = nptr;
+        (void)out_scanned;
+        return 0;
     }
 
