-static int load_and_discover(const char *path, psp_blob *b, elf_info *e,
+static int load_and_discover(const char *path, uint32_t base, uint8_t **out_reloc_buf, size_t *out_reloc_sz,
+                             psp_blob *b, elf_info *e,
